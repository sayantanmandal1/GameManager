# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=http://localhost:8000

# Optional WebRTC relay for restrictive NAT/firewall networks. Browser TURN
# credentials are public by design; use short-lived credentials from a TURN
# provider rather than a long-lived infrastructure secret.
# NEXT_PUBLIC_TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# NEXT_PUBLIC_TURN_USERNAME=<REPLACE_ME>
# NEXT_PUBLIC_TURN_CREDENTIAL=<REPLACE_ME>
